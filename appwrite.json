{
	"projectId": "life-in-skills",
	"projectName": "Life in Skills",
	"settings": {
		"services": {
			"account": true,
			"avatars": true,
			"databases": true,
			"locale": true,
			"health": true,
			"storage": true,
			"teams": true,
			"users": true,
			"functions": true,
			"graphql": true,
			"messaging": true
		},
		"auth": {
			"methods": {
				"jwt": true,
				"phone": true,
				"invites": true,
				"anonymous": true,
				"email-otp": true,
				"magic-url": true,
				"email-password": true
			},
			"security": {
				"duration": 31536000,
				"limit": 0,
				"sessionsLimit": 10,
				"passwordHistory": 0,
				"passwordDictionary": false,
				"personalDataCheck": false,
				"sessionAlerts": false,
				"mockNumbers": []
			}
		}
	},
	"databases": [
		{
			"$id": "main",
			"name": "main",
			"enabled": true
		}
	],
	"collections": [
		{
			"$id": "skills",
			"$permissions": ["create(\"users\")"],
			"databaseId": "main",
			"name": "skills",
			"enabled": true,
			"documentSecurity": true,
			"attributes": [
				{
					"key": "name",
					"type": "string",
					"required": true,
					"array": false,
					"size": 266,
					"default": null
				},
				{
					"key": "icon",
					"type": "string",
					"required": true,
					"array": false,
					"size": 5,
					"default": null
				},
				{
					"key": "targetLevel",
					"type": "integer",
					"required": true,
					"array": false,
					"min": 1,
					"max": 120,
					"default": null
				},
				{
					"key": "xp",
					"type": "integer",
					"required": false,
					"array": false,
					"min": 0,
					"max": 9223372036854775807,
					"default": 0
				},
				{
					"key": "lastActivityAt",
					"type": "datetime",
					"required": false,
					"array": false,
					"format": "",
					"default": null
				},
				{
					"key": "smallXpName",
					"type": "string",
					"required": false,
					"array": false,
					"size": 255,
					"default": "Quick win"
				},
				{
					"key": "mediumXpName",
					"type": "string",
					"required": false,
					"array": false,
					"size": 255,
					"default": "Regular"
				},
				{
					"key": "bigXpName",
					"type": "string",
					"required": false,
					"array": false,
					"size": 255,
					"default": "High effort"
				},
				{
					"key": "reward",
					"type": "string",
					"required": false,
					"array": false,
					"size": 255,
					"default": null
				},
				{
					"key": "userId",
					"type": "string",
					"required": true,
					"array": false,
					"size": 255,
					"default": null
				}
			],
			"indexes": []
		},
		{
			"$id": "activity",
			"$permissions": ["create(\"users\")"],
			"databaseId": "main",
			"name": "activity",
			"enabled": true,
			"documentSecurity": true,
			"attributes": [
				{
					"key": "text",
					"type": "string",
					"required": true,
					"array": false,
					"size": 1024,
					"default": null
				},
				{
					"key": "note",
					"type": "string",
					"required": false,
					"array": false,
					"size": 255,
					"default": null
				},
				{
					"key": "icon",
					"type": "string",
					"required": false,
					"array": false,
					"size": 255,
					"default": null
				}
			],
			"indexes": []
		},
		{
			"$id": "combat",
			"$permissions": ["create(\"users\")"],
			"databaseId": "main",
			"name": "combat",
			"enabled": true,
			"documentSecurity": true,
			"attributes": [
				{
					"key": "hp",
					"type": "integer",
					"required": false,
					"array": false,
					"min": 0,
					"max": 100,
					"default": 12
				},
				{
					"key": "deaths",
					"type": "integer",
					"required": false,
					"array": false,
					"min": 0,
					"max": 9223372036854775807,
					"default": 0
				}
			],
			"indexes": []
		},
		{
			"$id": "combatActions",
			"$permissions": ["create(\"users\")"],
			"databaseId": "main",
			"name": "combatActions",
			"enabled": true,
			"documentSecurity": true,
			"attributes": [
				{
					"key": "name",
					"type": "string",
					"required": true,
					"array": false,
					"size": 255,
					"default": null
				},
				{
					"key": "type",
					"type": "string",
					"required": true,
					"array": false,
					"elements": ["craving", "potion"],
					"format": "enum",
					"default": null
				},
				{
					"key": "power",
					"type": "integer",
					"required": true,
					"array": false,
					"min": 1,
					"max": 12,
					"default": null
				}
			],
			"indexes": []
		},
		{
			"$id": "publicProfiles",
			"$permissions": ["read(\"any\")", "create(\"users\")"],
			"databaseId": "main",
			"name": "publicProfiles",
			"enabled": true,
			"documentSecurity": true,
			"attributes": [
				{
					"key": "userId",
					"type": "string",
					"required": true,
					"array": false,
					"size": 255,
					"default": null
				}
			],
			"indexes": []
		}
	],
	"functions": [
		{
			"$id": "api",
			"name": "api",
			"runtime": "go-1.23",
			"execute": ["users"],
			"events": [],
			"scopes": [],
			"schedule": "",
			"timeout": 15,
			"enabled": true,
			"logging": true,
			"entrypoint": "main.go",
			"commands": "",
			"path": "functions/api"
		}
	]
}
